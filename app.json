{
  "expo": {
    "name": "DaSan Auto",
    "slug": "dasan-auto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.dasan.auto",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "DaSan Auto necesita acceso a la cámara para fotografiar los coches.",
        "NSPhotoLibraryUsageDescription": "DaSan Auto necesita acceso a tus fotos para añadir imágenes de coches."
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
