{
  "expo": {
    "name": "DaSan Auto",
    "slug": "dasan-auto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2563EB"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.dasan.auto",
      "versionCode": 1
    },
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "DaSan Auto necesita acceso a tus fotos para añadir imágenes de coches.",
          "cameraPermission": "DaSan Auto necesita acceso a la cámara para fotografiar los coches."
        }
      ]
    ]
  }
}
